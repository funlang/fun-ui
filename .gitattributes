# ===========================================================================
# fun-ui - .gitattributes
#
# Git stores LF in the object database and converts on checkout. Cross-platform
# sources and documentation use LF. Only Windows-centric Delphi and batch
# files use CRLF.
# ===========================================================================

* text=auto eol=lf

# ---- Windows-centric sources ----
*.pas     text eol=crlf
*.inc     text eol=crlf
*.dpr     text eol=crlf
*.dfm     text eol=crlf
*.cfg     text eol=crlf
*.bat     text eol=crlf

# ---- Cross-platform sources and documentation ----
*.fun     text eol=lf
*.js      text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.json    text eol=lf
LICENSE   text eol=lf
.gitignore    text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf

# ---- Language statistics ----
# Fun has no github/linguist entry, and `*.fun` is already one of Standard ML's
# suffixes there, so GitHub reports this repository as "Standard ML" and
# highlights every script as SML. Fun's syntax is Ada-derived (`if ... then
# ... elsif ... end if`, `case ... is ... end case`, `loop ... end loop`,
# `fun ... end fun`, `:=`, `;`-terminated statements), so label the scripts as
# Ada until Fun itself is registered with linguist. This only steers the
# language bar and the web highlighter; it does not change the files, and it
# is safe to drop once `Fun` exists in languages.yml.
*.fun     linguist-language=Ada

# ---- Binary files ----
*.exe     binary
*.dll     binary
*.dcu     binary
*.dcp     binary
*.res     binary
*.ico     binary
*.png     binary
*.jpg     binary
