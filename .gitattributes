# ===========================================================================
# fun-ui - .gitattributes
#
# Git stores LF in the object database and converts on checkout. Cross-platform
# sources and documentation use LF. Only Windows-centric Delphi and batch
# files use CRLF.
# ===========================================================================

* text=auto eol=lf

# ---- Windows-centric sources ----
*.pas     text eol=crlf
*.inc     text eol=crlf
*.dpr     text eol=crlf
*.dfm     text eol=crlf
*.cfg     text eol=crlf
*.bat     text eol=crlf

# ---- Cross-platform sources and documentation ----
*.fun     text eol=lf
*.js      text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.json    text eol=lf
LICENSE   text eol=lf
.gitignore    text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf

# ---- Binary files ----
*.exe     binary
*.dll     binary
*.dcu     binary
*.dcp     binary
*.res     binary
*.ico     binary
*.png     binary
*.jpg     binary
